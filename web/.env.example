# The app opens on NEAR testnet. Pick NEAR mainnet or Demo with the switch at the top of the dashboard.
# Nothing here is needed to READ a vault: type its account in the app. Keys are only for sending transactions.

# Which NEAR network this server signs for: testnet (default) or mainnet
NEAR_NETWORK=testnet
# The vault this server can write to (approvals, agent runs). Use NEAR_MAINNET_VAULT_ID for mainnet.
NEAR_VAULT_ID=
# Optional RPC override. Defaults: https://test.rpc.fastnear.com and https://free.rpc.fastnear.com
NEAR_RPC_URL=

NEAR_OWNER_ID=
# Server keys for the agents and the guard (ed25519:...). Use testnet keys first.
NEAR_PAYABLES_ID=
NEAR_PAYABLES_KEY=
NEAR_REVENUE_ID=
NEAR_REVENUE_KEY=
NEAR_GUARD_ID=
NEAR_GUARD_KEY=
# Pays gas to submit owner actions signed in MetaMask. It cannot act alone: the contract checks the signature.
NEAR_RELAYER_ID=
NEAR_RELAYER_KEY=
# Ops agent: pays for APIs per call (x402). NEAR_OPS_PAY_TO is the paid API's account.
NEAR_OPS_ID=
NEAR_OPS_KEY=
NEAR_OPS_PAY_TO=weather-api.testnet

# Alerts when a payment waits for you, is blocked, or an agent is auto paused. Any of these.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Slack or Discord incoming webhook
ALERT_WEBHOOK_URL=
# Email through resend.com
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=

# Invoice by email: POST /api/inbound/email?key=INBOUND_EMAIL_SECRET from your inbound email service
INBOUND_EMAIL_SECRET=
# Optional comma separated senders to accept, for example billing@lumen.studio,kite-labs.dev
INBOUND_EMAIL_FROM=

# Cross chain payouts through NEAR Intents (1Click API)
INTENTS_JWT=

# Plain language reasons from NEAR AI
NEAR_AI_API_KEY=

# Link shown on the landing page
NEXT_PUBLIC_REPO_URL=https://github.com/YOUR_NAME/agentguard

# AI (optional). OpenAI is used when OPENAI_API_KEY is set, else NEAR AI.
# It words the agent reasons and adds a model reviewer to the privacy audit. Money never depends on it.
OPENAI_API_KEY=
# Exact model id from your OpenAI account
OPENAI_MODEL=
NEAR_AI_API_KEY=
